<launch>
    <arg name="robot_type" default="go1" doc="Robot type: [a1, aliengo, go1, laikago]"/>
    <arg name="enable_send" default="false" doc="Enable sending UDP commands to robot"/>

    <param name="legged_robot_description" command="$(find xacro)/xacro $(find legged_unitree_description)/urdf/robot.xacro
       robot_type:=$(arg robot_type)
    "/>
    <node name="generate_urdf" pkg="legged_common" type="generate_urdf.sh" output="screen"
          args="$(find legged_unitree_description)/urdf/robot.xacro $(arg robot_type)"/>

    <rosparam file="$(find legged_unitree_hw_free)/config/$(arg robot_type).yaml" command="load"/>

    <param name="robot_type" value="$(arg robot_type)"/>
    <param name="enable_send" value="$(arg enable_send)"/>
    <include file="$(find legged_unitree_hw_free)/launch/$(arg robot_type).launch"/>
</launch>
